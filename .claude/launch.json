{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "reel-crew",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "exec .venv/bin/uvicorn api.main:app --host 127.0.0.1 --port ${PORT:-8000} --reload"
